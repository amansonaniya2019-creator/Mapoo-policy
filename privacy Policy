    async function executeSearchLocation(phoneInput) {
      const resultCard = document.getElementById('searchResult');
      resultCard.classList.remove('active');
      try {
        // Search through a restricted RPC so the client requests only one phone number,
        // rather than having direct SELECT access to every visible profile.
        const { data: rows, error } = await supabaseClient.rpc('search_visible_profile', { p_phone: phoneInput });
        if (error) throw error;
        const data = Array.isArray(rows) ? rows[0] : rows;
        const searchStatus = String(data?.status || data?.search_status || data?.result || '').toLowerCase();
        if (!data || data.latitude == null || data.longitude == null) {
          // The current search_visible_profile RPC returns only searchable profiles.
          // If the backend is later updated to return these status values, show the
          // exact reason; an empty result by itself cannot distinguish the two cases.
          resultCard.classList.remove('active');
          if (['not_registered', 'not_found', 'unregistered'].includes(searchStatus)) {
            alert("यह मोबाइल नंबर MAPOO पर रजिस्टर नहीं है।");
          } else if (['search_off', 'hidden', 'not_visible'].includes(searchStatus)) {
            alert("इस यूज़र ने अपनी प्रोफाइल का सर्च OFF कर रखा है।");
          } else {
            alert("इस मोबाइल नंबर की प्रोफाइल नहीं मिली। संभव है कि इस नंबर से MAPOO पर रजिस्ट्रेशन नहीं हुआ है, या उस यूज़र ने अपनी प्रोफाइल का सर्च OFF कर रखा है।");
          }
          return;
        }
        document.getElementById('resName').innerText = data.full_name || 'नाम उपलब्ध नहीं';
        document.getElementById('resFather').innerText = "पिता: " + (data.father_name || 'उपलब्ध नहीं');
        document.getElementById('resAddress').innerText = "पता: " + (data.address || 'उपलब्ध नहीं');
        document.getElementById('resMohalla').innerText = "मोहल्ला: " + (data.mohalla || 'उपलब्ध नहीं');
        document.getElementById('resAvatar').innerText = (data.full_name || '?').charAt(0).toUpperCase();
        const lat = Number(data.latitude);
        const lng = Number(data.longitude);
        if (!Number.isFinite(lat) || !Number.isFinite(lng) || lat < -90 || lat > 90 || lng < -180 || lng > 180) {
          alert("इस प्रोफाइल के GPS निर्देशांक सही नहीं हैं।"); return;
        }
        const exactPoint = `${lat},${lng}`;
        document.getElementById('resCoordinates').innerText = `${lat},${lng}`;
        // Destination is the saved user's exact GPS point. Google Maps uses the searcher's
        // current device location as the starting point when origin is omitted.
        document.getElementById('googleMapsLink').href =
          `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(exactPoint)}`;
        resultCard.classList.add('active');
        document.getElementById('googleMapsLink').setAttribute('aria-label', `रास्ता दिखाएँ: ${data.full_name || 'यूज़र'} की सेव की हुई लोकेशन तक`);
        showStatus('सर्च सफल रहा। प्रोफाइल और सेव की गई लोकेशन मिल गई है।');
      } catch (error) { alert("सर्च नहीं हो पाया: " + (error.message || "Supabase सेटिंग जाँचें।")); }
    }

    async function toggleVisibility(isVisible) {
      const visibilityState = document.getElementById('visibilityState');
      if (visibilityState) visibilityState.textContent = isVisible ? 'सर्च में दिखाई देगी' : 'सर्च से छुपी रहेगी';
      if (!supabaseClient || !enteredPhone || !enteredUid) { document.getElementById('visibilityToggle').checked = false; alert("पहले PIN से लॉगिन करें।"); return; }
      try {
        const { data, error } = await supabaseClient.rpc('mapoo_set_visibility', { p_account_id: enteredUid, p_is_visible: isVisible });
        if (error) throw error;
        if (data === false) { document.getElementById('visibilityToggle').checked = false; alert("पहले अपनी प्रोफाइल और GPS लोकेशन सेव करें।"); return; }
        localStorage.setItem('mapoo_visibility_user_changed', 'yes');
        showStatus(isVisible ? "आपकी प्रोफाइल सर्च में दिखाई देगी।" : "आपकी प्रोफाइल सर्च से छुपा दी गई है।");
      } catch (error) {
        document.getElementById('visibilityToggle').checked = !isVisible;
        if (visibilityState) visibilityState.textContent = !isVisible ? 'सर्च में दिखाई देगी' : 'सर्च से छुपी रहेगी';
        alert("सेटिंग अपडेट नहीं हुई: " + error.message);
      }
    }

    function showStatus(text) {
      const statusBox = document.getElementById('locationStatus');
      document.getElementById('statusText').innerText = text;
      statusBox.style.display = 'flex';
      setTimeout(() => { statusBox.style.display = 'none'; }, 4000);
    }

    async function initializeBannerAds() {
      const plugin = window.Capacitor?.Plugins?.AdMob || window.Capacitor?.Plugins?.GoogleAdMob;
      if (!plugin) { console.warn('AdMob native plugin unavailable; bottom test banner skipped.'); return; }
      try {
        // Most Capacitor AdMob plugins support only one banner view at a time.
        // Prefer the bottom banner; the top slot remains ready for a second native banner view
        // only if the installed plugin explicitly supports multiple banner instances.
        if (typeof plugin.showBanner === 'function') {
          await plugin.showBanner({ adUnitId: ADMOB_TEST_BANNER_ID, position: 'BOTTOM', margin: 0 });
        } else if (typeof plugin.showBannerAd === 'function') {
          await plugin.showBannerAd({ adId: ADMOB_TEST_BANNER_ID, position: 'BOTTOM' });
        } else {
          console.warn('AdMob plugin found, but its banner API is not supported by this HTML bridge.');
        }
      } catch (error) {
        console.warn('AdMob test banner:', error);
      }
    }

    async function deleteProfile() {
      if (!supabaseClient || !enteredPhone || !enteredUid) { alert("पहले PIN से लॉगिन करें।"); return; }
      if (!confirm("क्या आप अपनी प्रोफाइल और अकाउंट हमेशा के लिए मिटाना चाहते हैं?")) return;
      try {
        const { error } = await supabaseClient.rpc('mapoo_delete_own_account', { p_account_id: enteredUid });
        if (error) throw error;
        localStorage.removeItem('mapoo_saved_phone');
        localStorage.removeItem('mapoo_account_id');
        localStorage.removeItem('mapoo_account_created');
        localStorage.removeItem('mapoo_profile_completed');
        localStorage.removeItem('mapoo_visibility_user_changed');
        enteredPhone = ''; enteredUid = '';
        document.getElementById('mainAppContainer').style.display = 'none';
        document.getElementById('consentScreen').style.display = 'flex';
        localStorage.removeItem('mapooPrivacyConsentV1');
        document.getElementById('firstTimeGate').style.display = 'none';
        document.getElementById('profileForm').reset();
        document.getElementById('settingsMenu').classList.remove('open');
        document.getElementById('visibilityToggle').checked = false;
        showStatus("आपका प्रोफाइल डेटा मिटा दिया गया।");
      } catch (error) { alert("डेटा मिटाया नहीं जा सका: " + error.message); }
    }
  </script>
</body>
</html>
