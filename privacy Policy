<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>MAPOO - मैपू</title>
  
  <!-- Google Fonts & FontAwesome -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Supabase JS Client -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script type="module">
    try {
      const mod = await import("https://esm.sh/@capacitor/geolocation@8.2.4");
      window.MapooNativeGeolocation = mod.Geolocation;
      window.MapooGeolocationModuleError = null;
    } catch (e) {
      window.MapooGeolocationModuleError = String(e?.message || e);
      console.error("MAPOO Geolocation module load failed:", e);
    }
  </script>

  <style>
    :root {
      --bg-dark: #070a11;
      --card-bg: rgba(16, 24, 38, 0.88);
      --accent-emerald: #10b981;
      --accent-teal: #06b6d4;
      --glow-emerald: rgba(16, 185, 129, 0.35);
      --glow-teal: rgba(6, 182, 212, 0.35);
      --text-main: #f3f4f6;
      --text-muted: #9ca3af;
      --border-color: rgba(255, 255, 255, 0.1);
      --danger: #ef4444;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(circle at 10% 15%, rgba(16, 185, 129, 0.18) 0%, transparent 45%),
        radial-gradient(circle at 90% 85%, rgba(6, 182, 212, 0.18) 0%, transparent 45%);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 12px 12px 70px 12px;
    }

    .app-container {
      width: 100%;
      max-width: 440px;
      background: var(--card-bg);
      backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px);
      border: 1px solid var(--border-color);
      border-radius: 28px;
      padding: 22px;
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.8);
      margin: auto 0;
    }

    /* MAPOO CUSTOM EMBLEM LOGO */
    .mapo-logo-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-bottom: 6px;
    }

    .mapo-svg-icon {
      width: 46px;
      height: 46px;
      filter: drop-shadow(0 0 12px var(--glow-teal));
    }

    .logo-text {
      font-size: 1.8rem;
      font-weight: 800;
      background: linear-gradient(135deg, #2dd4bf, #38bdf8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      letter-spacing: 1.5px;
    }

    /* GATE MODAL */
    .gate-overlay {
      position: fixed;
      inset: 0;
      background: rgba(7, 10, 17, 0.96);
      backdrop-filter: blur(18px);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .gate-card {
      width: 100%;
      max-width: 380px;
      background: rgba(18, 26, 41, 0.95);
      border: 1px solid rgba(16, 185, 129, 0.3);
      border-radius: 26px;
      padding: 26px 22px;
      text-align: center;
      box-shadow: 0 0 50px var(--glow-emerald);
    }

    .app-header {
      text-align: center;
      margin-bottom: 20px;
    }

    .tagline {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-top: 4px;
    }

    /* TABS */
    .tab-bar {
      display: flex;
      background: rgba(0, 0, 0, 0.45);
      padding: 4px;
      border-radius: 16px;
      border: 1px solid var(--border-color);
      margin-bottom: 20px;
    }

    .tab-btn {
      flex: 1;
      padding: 11px 0;
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-weight: 600;
      font-size: 0.85rem;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .tab-btn.active {
      background: linear-gradient(135deg, var(--accent-emerald), var(--accent-teal));
      color: #041812;
      font-weight: 800;
      box-shadow: 0 4px 18px var(--glow-emerald);
    }

    .view-section {
      display: none;
      animation: fadeIn 0.3s ease forwards;
    }

    .view-section.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .input-group {
      margin-bottom: 14px;
      text-align: left;
    }

    .input-group label {
      display: block;
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .input-box {
      width: 100%;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-color);
      padding: 13px 16px;
      border-radius: 14px;
      color: #fff;
      font-size: 0.95rem;
      outline: none;
    }

    .input-box:focus {
      border-color: var(--accent-teal);
      box-shadow: 0 0 12px rgba(6, 182, 212, 0.3);
    }

    .btn-primary {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 16px;
      background: linear-gradient(135deg, var(--accent-emerald), var(--accent-teal));
      color: #041812;
      font-size: 0.95rem;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 6px 20px var(--glow-emerald);
      margin-top: 10px;
    }

    .btn-secondary {
      width: 100%;
      padding: 12px;
      border: 1px solid var(--accent-teal);
      border-radius: 16px;
      background: rgba(6, 182, 212, 0.1);
      color: var(--accent-teal);
      font-size: 0.88rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 10px;
    }

    .otp-inputs {
      display: flex;
      gap: 10px;
      justify-content: center;
      margin: 15px 0;
    }

    .otp-field {
      width: 48px;
      height: 52px;
      text-align: center;
      font-size: 1.3rem;
      font-weight: 800;
      background: rgba(255,255,255,0.06);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      color: #fff;
    }

    .otp-field:focus {
      border-color: var(--accent-emerald);
      box-shadow: 0 0 10px var(--glow-emerald);
      outline: none;
    }

    /* PRIVACY TOGGLE */
    .privacy-card {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-color);
      border-radius: 18px;
      padding: 14px;
      margin-top: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .privacy-info h4 { font-size: 0.9rem; color: var(--text-main); }
    .privacy-info p { font-size: 0.72rem; color: var(--text-muted); }

    .switch {
      position: relative;
      display: inline-block;
      width: 48px;
      height: 26px;
    }

    .switch input { opacity: 0; width: 0; height: 0; }

    .slider {
      position: absolute;
      cursor: pointer;
      inset: 0;
      background-color: rgba(255, 255, 255, 0.2);
      transition: .4s;
      border-radius: 34px;
    }

    .slider:before {
      position: absolute;
      content: "";
      height: 18px; width: 18px;
      left: 4px; bottom: 4px;
      background-color: white;
      transition: .4s;
      border-radius: 50%;
    }

    input:checked + .slider { background-color: var(--accent-emerald); }
    input:checked + .slider:before { transform: translateX(22px); }


    .gps-panel {
      margin: 14px 0 16px; padding: 16px; border-radius: 18px;
      background: linear-gradient(145deg, rgba(6,182,212,.13), rgba(16,185,129,.10));
      border: 1px solid rgba(45,212,191,.28);
      box-shadow: 0 12px 28px rgba(0,0,0,.18), inset 0 1px 0 rgba(255,255,255,.06);
    }
    .gps-panel h3 { margin:0 0 6px; font-size:1rem; color:var(--text-main); }
    .gps-panel p { margin:0 0 12px; color:var(--text-muted); font-size:.82rem; line-height:1.55; }
    .gps-actions { display:grid; grid-template-columns:1fr; gap:10px; }
    .gps-action-btn {
      width:100%; border:0; border-radius:13px; padding:13px 14px;
      display:flex; align-items:center; justify-content:center; gap:9px;
      font-weight:800; cursor:pointer; color:#041311;
      background:linear-gradient(135deg,#5eead4,#34d399);
      box-shadow:0 7px 18px rgba(16,185,129,.22);
    }
    .gps-action-btn.secondary {
      color:#eaf6ff; background:linear-gradient(135deg,#2563eb,#0ea5e9);
      box-shadow:0 7px 18px rgba(37,99,235,.22);
    }
    .gps-action-btn:disabled { opacity:.6; cursor:wait; }
    #gpsPreview { display:none; margin-top:12px; padding:11px; border-radius:12px;
      background:rgba(0,0,0,.22); color:var(--text-main); font-size:.78rem; line-height:1.6; overflow-wrap:anywhere; }
    #gpsPreview a { color:#7dd3fc; font-weight:700; }
    .settings-menu {
      background:linear-gradient(155deg,rgba(20,31,48,.98),rgba(8,15,27,.98));
      border:1px solid rgba(94,234,212,.28); border-radius:20px;
      box-shadow:0 18px 48px rgba(0,0,0,.58), inset 0 1px 0 rgba(255,255,255,.07);
      backdrop-filter:blur(18px); padding:16px;
    }
    .settings-menu .privacy-card { padding:14px; border-radius:15px; background:rgba(255,255,255,.055); }
    .settings-menu .btn-danger { border-radius:13px; }

    /* RESULTS CARD */
    .result-card {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border-color);
      border-radius: 20px;
      padding: 18px;
      margin-top: 16px;
      text-align: center;
      display: none;
    }

    .result-card.active { display: block; }

    .user-avatar {
      width: 55px; height: 55px;
      background: linear-gradient(135deg, var(--accent-teal), var(--accent-emerald));
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.4rem; color: #000;
      margin: 0 auto 10px; font-weight: 800;
    }

    .maps-btn {
      width: 100%;
      padding: 13px;
      background: #4285F4;
      color: #fff;
      border: none;
      border-radius: 14px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      margin-top: 12px;
      display: flex; align-items: center; justify-content: center;
      gap: 8px; text-decoration: none;
      box-shadow: 0 4px 15px rgba(66, 133, 244, 0.35);
    }

    /* REWARDED AD MODAL */
    .ad-modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.94);
      backdrop-filter: blur(12px);
      z-index: 2000;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .ad-modal.active { display: flex; }

    .ad-card {
      width: 100%;
      max-width: 340px;
      background: #111827;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 20px;
      padding: 20px;
      text-align: center;
    }

    .ad-timer-badge {
      display: inline-block;
      background: rgba(239, 68, 68, 0.2);
      color: #f87171;
      border: 1px solid #ef4444;
      padding: 6px 14px;
      border-radius: 30px;
      font-weight: 800;
      font-size: 0.85rem;
      margin-bottom: 12px;
    }

    .btn-danger {
      width: 100%;
      padding: 11px;
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: var(--danger);
      border-radius: 14px;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 16px;
      display: flex; align-items: center; justify-content: center;
      gap: 6px;
    }

    .top-banner-ad {
      position: relative;
      width: 100%;
      min-height: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 900;
      background: #000;
    }

    /* STICKY BOTTOM BANNER AD */
    .sticky-banner-ad {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 52px;
      background: #000;
      border-top: 1px solid rgba(255,255,255,0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 900;
    }

    .status-card {
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.3);
      border-radius: 14px;
      padding: 12px;
      margin-top: 12px;
      font-size: 0.82rem;
      color: #34d399;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .consent-overlay { position: fixed; inset: 0; z-index: 1200; display: flex; align-items: center; justify-content: center; padding: 20px; background: #000; color: #f9fafb; }
    .consent-card { width: 100%; max-width: 420px; padding: 26px 22px; border: 1px solid rgba(16,185,129,.45); border-radius: 20px; background: #050505; text-align: left; box-shadow: 0 0 35px rgba(16,185,129,.12); }
    .consent-card h2 { color: #34d399; margin-bottom: 14px; font-size: 1.25rem; }
    .consent-card p { color: #d1d5db; font-size: .88rem; line-height: 1.65; margin-bottom: 12px; }
    .header-actions { display:flex; justify-content:flex-end; margin-bottom: 8px; position:relative; }
    .settings-btn { background:rgba(0,0,0,.35); border:1px solid var(--border-color); color:var(--text-main); border-radius:12px; padding:9px 12px; cursor:pointer; }
    .settings-menu { display:none; position:absolute; top:44px; right:0; width:min(280px, 85vw); padding:14px; background:#101826; border:1px solid var(--border-color); border-radius:16px; z-index:950; box-shadow:0 12px 30px rgba(0,0,0,.45); }
    .settings-menu.open { display:block; }
    .settings-menu .privacy-card { margin:0 0 12px; }
    .settings-menu .btn-danger { margin-top:8px; }
    .settings-menu { padding:15px; border-radius:20px; width:min(320px,90vw); }
    .settings-heading { display:flex; align-items:center; gap:11px; padding:3px 2px 14px; margin-bottom:12px; border-bottom:1px solid rgba(255,255,255,.09); }
    .settings-heading-icon { width:39px; height:39px; flex:0 0 39px; display:grid; place-items:center; border-radius:13px; color:#5eead4; background:linear-gradient(145deg,rgba(16,185,129,.2),rgba(6,182,212,.16)); border:1px solid rgba(94,234,212,.22); }
    .settings-heading strong { display:block; color:#f8fafc; font-size:.92rem; letter-spacing:.1px; }
    .settings-heading small { display:block; color:#94a3b8; font-size:.68rem; margin-top:3px; }
    .settings-menu .privacy-card { gap:12px; align-items:center; padding:15px 13px; border:1px solid rgba(94,234,212,.17); background:linear-gradient(145deg,rgba(16,185,129,.09),rgba(255,255,255,.035)); box-shadow:inset 0 1px 0 rgba(255,255,255,.04); }
    .settings-menu .privacy-info { min-width:0; flex:1; }
    .settings-menu .privacy-info h4 { display:flex; align-items:center; gap:7px; font-size:.82rem; line-height:1.4; margin-bottom:6px; }
    .settings-menu .privacy-info h4 i { color:#5eead4; }
    .settings-menu .privacy-info p { font-size:.68rem; line-height:1.55; color:#aab7c8; }
    .privacy-state { display:inline-flex; align-items:center; margin-top:9px; padding:4px 8px; border-radius:20px; font-size:.64rem; font-weight:800; color:#6ee7b7; background:rgba(16,185,129,.13); }
    .settings-menu .switch { flex:0 0 48px; }
    .settings-menu .btn-danger { width:100%; padding:12px; display:flex; align-items:center; justify-content:center; gap:8px; font-weight:800; }

  </style>
</head>
<body>
  <div id="startupLoader" style="display:none;position:fixed;inset:0;z-index:3000;background:#0b1220;color:#fff;align-items:center;justify-content:center;flex-direction:column;gap:14px;">
    <i class="fa-solid fa-spinner fa-spin" style="font-size:32px;color:#10b981;"></i>
    <div style="font-weight:700;">MAPOO खुल रहा है...</div>
    <small style="color:#aab4c5;">आपका लॉगिन जाँचा जा रहा है</small>
  </div>

  <!-- Privacy confirmation is shown only until the user accepts it once. -->
  <div id="consentScreen" class="consent-overlay">
    <div class="consent-card">
      <div class="mapo-logo-wrapper" style="justify-content:flex-start; margin-bottom:18px;"><span class="logo-text">MAPOO</span></div>
      <h2>प्राइवेसी और डेटा की अनुमति</h2>
      <p>आगे बढ़ने पर आप सहमति देते हैं कि MAPOO की प्रोफाइल और लोकेशन खोज सुविधा चलाने के लिए आपके दिए गए नाम, पिता का नाम, पता, मोबाइल नंबर और GPS लोकेशन जैसी जानकारी सुरक्षित रखी जा सकती है।</p>
      <p>कृपया वही जानकारी साझा करें जिसे साझा करने में आपको कोई परेशानी या असुरक्षा महसूस न हो। आपकी प्रोफाइल का डेटा तब तक सुरक्षित रहेगा जब तक आप अपना अकाउंट या प्रोफाइल स्वयं नहीं हटाते। आप कभी भी अपनी प्रोफाइल हटा सकते हैं और सर्च में अपनी प्रोफाइल दिखाने की सेटिंग ON या OFF कर सकते हैं।</p>
      <p>आपकी GPS लोकेशन तभी ली जाएगी जब आप लोकेशन सेव करने का बटन दबाएँगे और लोकेशन की अनुमति देंगे। सर्च में आपकी प्रोफाइल तभी दिखाई देगी जब आपने सर्च सेटिंग ON रखी होगी।</p>
      <button class="btn-primary" type="button" onclick="acceptPrivacyConsent()"><i class="fa-solid fa-check"></i> कन्फर्म करें और आगे बढ़ें</button>
    </div>
  </div>

  <!-- ACCOUNT CREATE / PIN LOGIN GATE -->
  <div id="firstTimeGate" class="gate-overlay" style="display:none;">
    <div class="gate-card">
      <div class="mapo-logo-wrapper">
        <svg class="mapo-svg-icon" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="50" cy="50" r="46" fill="url(#bg-grad)" stroke="#10b981" stroke-width="3"/>
          <path d="M50 20C36.2 20 25 31.2 25 45C25 62.5 50 82 50 82C50 82 75 62.5 75 45C75 31.2 63.8 20 50 20Z" fill="url(#pin-grad)" stroke="#06b6d4" stroke-width="2"/>
          <path d="M42 52V42H58V52H42Z" fill="#ffffff"/>
          <path d="M50 34L37 43H63L50 34Z" fill="#34d399"/>
          <rect x="60" y="60" width="14" height="12" rx="2" fill="#fbbf24"/>
          <defs>
            <linearGradient id="bg-grad" x1="0" y1="0" x2="100" y2="100">
              <stop offset="0%" stop-color="#0f2027"/>
              <stop offset="100%" stop-color="#203a43"/>
            </linearGradient>
            <linearGradient id="pin-grad" x1="25" y1="20" x2="75" y2="82">
              <stop offset="0%" stop-color="#06b6d4"/>
              <stop offset="100%" stop-color="#10b981"/>
            </linearGradient>
          </defs>
        </svg>
        <span class="logo-text">MAPOO</span>
      </div>

      <h3 id="gateTitle" style="margin-bottom: 4px;">अकाउंट बनाएँ</h3>
      <p id="gateSub" style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 18px;">मोबाइल नंबर दर्ज करें और अपना 4 अंकों का PIN बनाएँ।</p>
      <div class="input-group" id="loginPhoneGroup"><label for="loginPhone">मोबाइल नंबर दर्ज करें</label><input class="input-box" id="loginPhone" type="tel" inputmode="numeric" maxlength="10" placeholder="10 अंकों का मोबाइल नंबर" autocomplete="tel"></div>
      <div class="input-group"><label for="loginPin" id="loginPinLabel">अपना 4 अंकों का PIN बनाएँ</label><input class="input-box" id="loginPin" type="text" inputmode="numeric" maxlength="4" autocomplete="off" placeholder="PIN दर्ज करें"></div>
      <button type="button" class="btn-primary" id="pinLoginBtn" onclick="loginWithPin()" style="display:none;"><i class="fa-solid fa-lock-open"></i> खोलें</button>
