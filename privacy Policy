        alert("सर्च नहीं हो पाया: " + (error.message || "कृपया फिर प्रयास करें।"));
      } finally {
        if (button) { button.disabled = false; button.innerHTML = '<i class="fa-solid fa-magnifying-glass"></i> लोकेशन ढूँढें'; }
