    async function startRewardedAd() {
      const plugin = window.Capacitor?.Plugins?.AdMob || window.Capacitor?.Plugins?.GoogleAdMob;
      if (!plugin) { console.warn('Rewarded Ad plugin unavailable; continuing to Google Maps without blocking.'); return true; }
