        alert('पहले अपने मोबाइल नंबर और PIN से लॉगिन करें।');
        return;
      }
      try {
        const { data, error } = await supabaseClient.rpc('mapoo_get_own_profile', { p_account_id: enteredUid });
        if (error) throw error;
        const own = Array.isArray(data) ? data[0] : data;
        const ownSaved = !!(own && own.full_name && own.father_name && own.address &&
          own.latitude != null && own.longitude != null);
        if (!ownSaved) {
          localStorage.removeItem('mapoo_profile_completed');
          alert('पहले अपनी प्रोफाइल और GPS लोकेशन सेव करें। उसके बाद ही नंबर सर्च कर पाएँगे।');
          switchTab('profile');
          return;
