    // Collect fresh GPS fixes for up to two minutes. Only accept a device-reported
    // accuracy radius of 3 metres or better; this is a device estimate, not a guarantee.
    const MAPOO_TARGET_GPS_ACCURACY_M = 3;
    const MAPOO_GPS_MAX_WAIT_MS = 30000;

    function collectBestBrowserGps(maxWaitMs = MAPOO_GPS_MAX_WAIT_MS, onUpdate = () => {}) {
      return new Promise((resolve, reject) => {
        if (!navigator.geolocation) return reject(new Error('इस डिवाइस में GPS उपलब्ध नहीं है।'));
        let watchId = null, best = null, readings = 0, finished = false;
        const startedAt = Date.now();
        const finish = (err) => {
          if (finished) return;
          finished = true;
          if (watchId !== null) navigator.geolocation.clearWatch(watchId);
          clearTimeout(timer);
          if (best && Number(best.coords.accuracy) <= MAPOO_TARGET_GPS_ACCURACY_M) resolve(best);
          else reject(err || new Error(best ? `30 सेकंड में GPS सटीकता ±${Math.round(best.coords.accuracy)} मीटर रही। ±3 मीटर या बेहतर फिक्स नहीं मिला, इसलिए लोकेशन सेव नहीं की गई। खुले स्थान पर मोबाइल स्थिर रखकर फिर कोशिश करें।` : 'GPS लोकेशन नहीं मिली।'));
        };
        const timer = setTimeout(() => finish(), maxWaitMs);
        watchId = navigator.geolocation.watchPosition(pos => {
          const c = pos?.coords;
          if (!c || !Number.isFinite(c.latitude) || !Number.isFinite(c.longitude) || !Number.isFinite(c.accuracy)) return;
          readings++;
          if (!best || c.accuracy < best.coords.accuracy) best = pos;
          onUpdate(c.accuracy, readings, Math.round((Date.now() - startedAt) / 1000));
          if (Date.now() - startedAt >= 5000 && readings >= 3 && c.accuracy <= MAPOO_TARGET_GPS_ACCURACY_M) finish();
        }, err => console.warn('Browser GPS watch:', err), {
          enableHighAccuracy: true, maximumAge: 0, timeout: maxWaitMs
        });
      });
    }

    function collectBestNativeGps(geo, maxWaitMs = MAPOO_GPS_MAX_WAIT_MS, onUpdate = () => {}) {
      return new Promise(async (resolve, reject) => {
        let watchId = null, best = null, readings = 0, finished = false;
        const startedAt = Date.now();
        const finish = async (err) => {
          if (finished) return;
          finished = true;
          clearTimeout(timer);
          if (watchId != null) {
            try { await geo.clearWatch({ id: watchId }); } catch (e) { console.warn('GPS watch cleanup:', e); }
          }
          if (best && Number(best.coords.accuracy) <= MAPOO_TARGET_GPS_ACCURACY_M) resolve(best);
          else reject(err || new Error(best ? `30 सेकंड में GPS सटीकता ±${Math.round(best.coords.accuracy)} मीटर रही। ±3 मीटर या बेहतर फिक्स नहीं मिला, इसलिए लोकेशन सेव नहीं की गई। खुले स्थान पर मोबाइल स्थिर रखकर फिर कोशिश करें।` : 'Native GPS से लोकेशन नहीं मिली।'));
        };
        const timer = setTimeout(() => { finish(); }, maxWaitMs);
        try {
          watchId = await geo.watchPosition({ enableHighAccuracy: true, maximumAge: 0, timeout: maxWaitMs }, (pos, err) => {
            if (finished) return;
            if (err) { console.warn('Native GPS watch:', err); return; }
            const c = pos?.coords;
            if (!c || !Number.isFinite(c.latitude) || !Number.isFinite(c.longitude) || !Number.isFinite(c.accuracy)) return;
            readings++;
            if (!best || c.accuracy < best.coords.accuracy) best = pos;
            onUpdate(c.accuracy, readings, Math.round((Date.now() - startedAt) / 1000));
            if (Date.now() - startedAt >= 5000 && readings >= 3 && c.accuracy <= MAPOO_TARGET_GPS_ACCURACY_M) finish();
          });
        } catch (err) { finish(err); }
      });
    }

    let capturedGpsPosition = null;

    // Android build requirement: install @capacitor/geolocation and run npx cap sync android.
    // The native plugin requests Android runtime location permission on this button click.

    function mapooGpsErrorMessage(error) {
      const raw = `${error?.message || ''} ${error?.code || ''}`.toLowerCase();

      if (error?.message === 'MAPOO_NATIVE_PLUGIN_MISSING') {
        return 'Android GPS plugin और WebView दोनों से लोकेशन नहीं मिली। @capacitor/geolocation की Android installation और npx cap sync android जाँचें।';
      }
      if (raw.includes('permission') || error?.code === 1 ||
          raw.includes('denied') || raw.includes('0003')) {
        return 'फोन की Location अनुमति बंद है। App info → Permissions → Location → Allow करें।';
      }
      // Timeout / no-fix errors must NOT be reported as the phone Location switch being OFF.
      if (error?.code === 3 || raw.includes('timeout') || raw.includes('timed out')) {
        return 'फोन की Location चालू हो सकती है, लेकिन अभी GPS से position नहीं मिली (timeout)। खुले स्थान या बेहतर GPS/Wi‑Fi सिग्नल में दोबारा कोशिश करें।';
      }
      // Only explicit provider-disabled messages are treated as the system Location switch being OFF.
      if (raw.includes('location services are disabled') ||
          raw.includes('location service is disabled') ||
          raw.includes('location provider is disabled') ||
          raw.includes('gps provider is disabled') ||
          raw.includes('location mode is off') ||
          raw.includes('gps is disabled') ||
          raw.includes('location is disabled')) {
        return 'Android ने Location service बंद बताई है। अगर फोन में Location पहले से ON है, तो फोन Restart करके फिर कोशिश करें; यह GPS provider की रिपोर्ट भी हो सकती है।';
      }
      if (error?.code === 2 || raw.includes('unavailable') ||
          raw.includes('position unavailable') || raw.includes('location services')) {
        return 'फोन की Location ON होने के बावजूद अभी GPS/Wi‑Fi/नेटवर्क से position नहीं मिली। यह Location OFF होने का पक्का प्रमाण नहीं है। 10–20 सेकंड बाद दोबारा कोशिश करें।';
      }
      return `लोकेशन प्राप्त नहीं हुई (${error?.message || 'अज्ञात GPS त्रुटि'})। फिर कोशिश करें।`;
    }

    async function captureGpsLocation() {
      const confirmed = window.confirm('सटीक GPS के लिए मोबाइल को एक जगह स्थिर रखें और खुले आसमान के नीचे रहें। घर की सटीक लोकेशन के लिए संभव हो तो घर की छत पर जाएँ। GPS अधिकतम 30 सेकंड तक जाँचा जाएगा। लोकेशन तभी स्वीकार होगी जब फोन की बताई सटीकता ±3 मीटर या उससे बेहतर हो। यह फोन का GPS अनुमान है; हर जगह 1–3 मीटर की गारंटी नहीं होती। क्या शुरू करें?');
      if (!confirmed) return;
      const gpsBtn = document.getElementById('getGpsBtn');
      const saveBtn = document.getElementById('saveBtn');
      const preview = document.getElementById('gpsPreview');
      gpsBtn.disabled = true;
      saveBtn.disabled = true;
      capturedGpsPosition = null;
      gpsBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> सटीक GPS खोज रहे हैं...';
      preview.style.display = 'block';
      preview.textContent = 'मोबाइल स्थिर रखें और संभव हो तो घर की छत पर खुले आसमान के नीचे रहें। GPS अधिकतम 30 सेकंड तक जाँचा जाएगा; ±3 मीटर या बेहतर सटीकता मिलने पर ही लोकेशन सेव होगी।';
      const gpsProgress = (accuracy, readings, elapsed) => { preview.textContent = `GPS जाँच जारी है… अभी सटीकता ±${Math.round(accuracy)} मीटर | ${elapsed}/30 सेकंड | ${readings} रीडिंग। मोबाइल स्थिर रखें; ±3 मीटर या बेहतर होने पर ही लोकेशन स्वीकार होगी।`; };

      try {
        let position = null;
        const isNative = !!(window.Capacitor?.isNativePlatform?.() || window.Capacitor?.getPlatform?.() === 'android');
        let nativeError = null;
        if (isNative && window.MapooNativeGeolocation) {
          const geo = window.MapooNativeGeolocation;
          let perms = await geo.checkPermissions();
          if (perms.location !== 'granted' && perms.coarseLocation !== 'granted') perms = await geo.requestPermissions();
          if (perms.location !== 'granted' && perms.coarseLocation !== 'granted') {
            throw Object.assign(new Error('Location permission denied'), { code: 1 });
          }
          // Native GPS gets the full 30-second budget. Do not start a second
          // 30-second WebView attempt after it, so total waiting stays bounded.
          position = await collectBestNativeGps(geo, MAPOO_GPS_MAX_WAIT_MS, gpsProgress);
        } else if (navigator.geolocation) {
          // Browser/WebView fallback also has a strict 30-second maximum.
          position = await collectBestBrowserGps(MAPOO_GPS_MAX_WAIT_MS, gpsProgress);
        }
        if (!position) throw nativeError || new Error('GPS position unavailable');

        const c = position.coords;
        const accuracy = Number(c.accuracy);
        if (!Number.isFinite(accuracy) || accuracy > MAPOO_TARGET_GPS_ACCURACY_M) {
          throw new Error(`GPS सटीकता ±${Math.round(accuracy || 0)} मीटर है। ±3 मीटर या बेहतर फिक्स के बिना लोकेशन सेव नहीं होगी। मोबाइल स्थिर रखकर खुले स्थान पर फिर कोशिश करें।`);
        }
        capturedGpsPosition = position;
        preview.innerHTML = `<strong style="color:#6ee7b7">बेहतर GPS लोकेशन मिल गई ✓</strong><br>Latitude: ${c.latitude.toFixed(7)}<br>Longitude: ${c.longitude.toFixed(7)}<br>डिवाइस की बताई सटीकता: लगभग ±${Math.round(accuracy)} मीटर<br>अब “सेव डिटेल्स” दबाएँ।`;
        saveBtn.disabled = false;
        gpsBtn.innerHTML = '<i class="fa-solid fa-circle-check"></i> लोकेशन मिल गई';
      } catch (error) {
        console.error('MAPOO GPS diagnostic:', error, 'module:', window.MapooGeolocationModuleError);
        capturedGpsPosition = null;
        saveBtn.disabled = true;
        const message = mapooGpsErrorMessage(error);
        preview.textContent = message;
        alert(message);
        gpsBtn.innerHTML = '<i class="fa-solid fa-location-dot"></i> दोबारा GPS जाँचें';
      } finally { gpsBtn.disabled = false; }
    }

    async function executeSaveProfile(event) {
      if (event) event.preventDefault();
      if (!supabaseClient || !enteredUid || !enteredPhone) { alert('पहले PIN से लॉगिन करें।'); return; }
      const fullName = document.getElementById('fullName').value.trim();
      const fatherName = document.getElementById('fatherName').value.trim();
      const mohalla = document.getElementById('mohalla').value.trim();
      const profilePhone = enteredPhone;
      if (!profilePhone) { alert('आपका अकाउंट मोबाइल नंबर उपलब्ध नहीं है। दोबारा PIN से लॉगिन करें।'); return; }
      if (!fullName || !fatherName || !mohalla) {
        alert('नाम, पिताजी का नाम और मोहल्ला/घर का विवरण भरें।'); return;
      }
      if (!capturedGpsPosition) {
        alert('पहले “अपनी लोकेशन चालू करें” बटन दबाकर GPS लोकेशन प्राप्त करें।');
        return;
      }

      const saveBtn = document.getElementById('saveBtn');
      saveBtn.disabled = true;
      saveBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> प्रोफाइल सेव हो रही है...';
      try {
        const position = capturedGpsPosition;
        const accuracy = Number(position.coords.accuracy);
        if (!Number.isFinite(accuracy) || accuracy > MAPOO_TARGET_GPS_ACCURACY_M) { alert(`यह GPS लोकेशन अभी ±${Math.round(accuracy || 0)} मीटर है। ±3 मीटर या बेहतर फिक्स के बिना इसे सेव नहीं किया जाएगा।`); return; }

        const userData = {
          full_name: fullName, father_name: fatherName, address: mohalla, mohalla,
          phone_number: enteredPhone, account_id: enteredUid,
          latitude: position.coords.latitude, longitude: position.coords.longitude,
          location_accuracy_m: Number.isFinite(accuracy) ? accuracy : null,
          is_visible: document.getElementById('visibilityToggle').checked,
          updated_at: new Date().toISOString()
        };
        const { error } = await supabaseClient.rpc('mapoo_save_own_profile', { p_account_id: enteredUid, p_profile: userData });
        if (error) throw error;
        localStorage.setItem('mapoo_saved_phone', enteredPhone);
        localStorage.setItem('mapoo_account_id', enteredUid);
        localStorage.setItem('mapoo_account_created', 'yes');
        localStorage.setItem('mapoo_profile_completed', 'yes');
        // Persist phone/account locally ONLY after the profile + GPS RPC succeeds.
        // Stay inside the app now; on the next cold launch the user enters PIN only.
        localStorage.setItem('mapooPrivacyConsentV1', 'accepted');
        document.getElementById('mainAppContainer').style.display = 'block';
        document.getElementById('firstTimeGate').style.display = 'none';
        showStatus('प्रोफाइल और लोकेशन सेव हो गई हैं। आप MAPOO इस्तेमाल कर सकते हैं।');
        // Profile save completes without requiring an advertising plugin.
      } catch (error) {
        alert('प्रोफाइल सेव नहीं हो सकी: ' + (error.message || 'GPS अनुमति और Supabase सेटिंग जाँचें।'));
      } finally {
        saveBtn.disabled = false;
        saveBtn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> सेव डिटेल्स';
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('searchPhone');
      if (!input) return;
      input.setAttribute('inputmode', 'numeric');
      input.setAttribute('maxlength', '10');
      input.addEventListener('input', () => {
        input.value = input.value.replace(/\D/g, '').slice(0, 10);
      });
      input.addEventListener('keydown', event => {
        if (event.key === 'Enter') {
          event.preventDefault();
          triggerSearchWithAd();
        }
      });
      const mapsLink = document.getElementById('googleMapsLink');
      if (mapsLink) {
        mapsLink.addEventListener('click', async event => {
          const mapUrl = mapsLink.href;
          if (!mapUrl || mapUrl === '#' || !/^https:\/\//i.test(mapUrl)) return;
          event.preventDefault();
          // Open a temporary tab synchronously so Android WebView does not block
          // Maps navigation after the asynchronous rewarded-ad flow.
          let mapWindow = null;
          try { mapWindow = window.open('about:blank', '_blank'); } catch (_) {}
          try { await startRewardedAd(); }
          finally {
            if (mapWindow && !mapWindow.closed) {
              try { mapWindow.location.replace(mapUrl); } catch (_) { window.location.href = mapUrl; }
            } else {
              window.location.href = mapUrl;
            }
          }
        });
      }
    });

    async function triggerSearchWithAd() {
      const phoneInput = normalizePhone(document.getElementById('searchPhone').value.trim());
