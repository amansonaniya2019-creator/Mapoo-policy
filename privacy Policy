  <script>
    // ================= MAPOO CONFIGURATION =================
    // Supabase Dashboard -> Project Settings -> API: Project URL + anon/publishable key.
    const SUPABASE_URL = "https://hqrogcawdddezacqpizp.supabase.co";
    const SUPABASE_ANON_KEY = "sb_publishable_90X6Uva5PFNllLXmuFtoCg_Ii8Pkn-A";

    // Google official sample ad units (TEST ONLY). Replace with your own IDs before release.
    const ADMOB_TEST_BANNER_ID = "ca-app-pub-3940256099942544/6300978111";
    const ADMOB_TEST_REWARDED_ID = "ca-app-pub-3940256099942544/5224354917";

    // Supabase PIN login. PIN verification and hashing happen on the server via RPC.
    const supabaseClient = (window.supabase && SUPABASE_URL && SUPABASE_ANON_KEY)
      ? window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY) : null;

    let enteredPhone = localStorage.getItem('mapoo_saved_phone') || '';
    let enteredUid = localStorage.getItem('mapoo_account_id') || '';

    function requireSupabase() {
      if (!supabaseClient) { alert("Supabase सेटअप पूरा नहीं है। SUPABASE_URL और SUPABASE_ANON_KEY जाँचें।"); return false; }
      return true;
    }
    function normalizePhone(value) {
      const digits = String(value || '').replace(/\D/g, '');
      return digits.length === 10 ? '+91' + digits : '';
    }
    function setGateBusy(busy, id, label) {
      const button = document.getElementById(id);
      if (!button) return;
      button.disabled = busy;
      if (busy) button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> ' + label;
      else if (id === 'pinLoginBtn') button.innerHTML = '<i class="fa-solid fa-lock-open"></i> खोलें';
      else button.innerHTML = '<i class="fa-solid fa-user-plus"></i> अकाउंट बनाएँ';
    }
    function updateLoginGate() {
      const hasPhone = !!localStorage.getItem('mapoo_saved_phone');
      const hasAccountId = !!localStorage.getItem('mapoo_account_id');
      const profileIsComplete = localStorage.getItem('mapoo_profile_completed') === 'yes';
      // PIN-only on later launches is enabled ONLY after profile + GPS save succeeds.
      // Incomplete registrations must enter phone + their existing PIN again.
      const isPinLogin = hasPhone && hasAccountId && profileIsComplete;
      const phoneGroup = document.getElementById('loginPhoneGroup');
      const createButton = document.getElementById('createPinBtn');
      const loginButton = document.getElementById('pinLoginBtn');
      const title = document.getElementById('gateTitle');
      const sub = document.getElementById('gateSub');
      const pinLabel = document.getElementById('loginPinLabel');

      if (phoneGroup) phoneGroup.style.display = isPinLogin ? 'none' : 'block';
      if (createButton) createButton.style.display = isPinLogin ? 'none' : 'block';
      if (loginButton) loginButton.style.display = isPinLogin ? 'block' : 'none';
      if (title) title.textContent = isPinLogin ? 'PIN से लॉगिन करें' : 'अकाउंट बनाएँ';
      if (sub) sub.textContent = isPinLogin
        ? 'अपना 4 अंकों का PIN दर्ज करें।'
        : 'मोबाइल नंबर दर्ज करें और अपना 4 अंकों का PIN बनाएँ।';
      if (pinLabel) pinLabel.textContent = isPinLogin
        ? 'अपना 4 अंकों का PIN दर्ज करें'
        : 'अपना 4 अंकों का PIN बनाएँ';
      enteredPhone = localStorage.getItem('mapoo_saved_phone') || '';
      const phoneInput = document.getElementById('loginPhone');
      if (phoneInput && enteredPhone) phoneInput.value = enteredPhone.replace(/^\+91/, '');
    }

    async function loginWithPin() {
      if (!requireSupabase()) return;
      const pin = document.getElementById('loginPin').value.trim();
      if (!/^\d{4}$/.test(pin)) { alert('कृपया 4 अंकों का PIN दर्ज करें।'); return; }
      enteredPhone = localStorage.getItem('mapoo_saved_phone') || '';
      if (!enteredPhone) {
        alert('इस डिवाइस पर मोबाइल नंबर सेव नहीं है। पहली बार अकाउंट बनाएँ।');
        updateLoginGate();
        document.getElementById('loginPhone').focus();
        return;
      }
      setGateBusy(true, 'pinLoginBtn', 'PIN जाँचा जा रहा है...');
      try {
        const { data, error } = await supabaseClient.rpc('mapoo_login_with_pin', { p_phone: enteredPhone, p_pin: pin });
        if (error) throw error;
        const account = Array.isArray(data) ? data[0] : data;
        if (!account || !account.account_id) throw new Error('PIN सही नहीं है।');
        enteredUid = account.account_id;
        document.getElementById('loginPin').value = '';
        const { data: profileData, error: profileError } = await supabaseClient.rpc(
          'mapoo_get_own_profile', { p_account_id: enteredUid }
        );
        if (profileError) throw profileError;
        const profileRow = Array.isArray(profileData) ? profileData[0] : profileData;
        const isComplete = !!(profileRow && profileRow.full_name && profileRow.father_name &&
          profileRow.address && profileRow.latitude != null && profileRow.longitude != null);
        if (isComplete) {
          localStorage.setItem('mapoo_saved_phone', enteredPhone);
          localStorage.setItem('mapoo_account_id', enteredUid);
          localStorage.setItem('mapoo_account_created', 'yes');
          localStorage.setItem('mapoo_profile_completed', 'yes');
        } else {
          // Keep phone/account ID locally before profile completion; never store the PIN.
          // On next launch the phone is prefilled, so the user only needs their PIN.
          localStorage.setItem('mapoo_saved_phone', enteredPhone);
          localStorage.setItem('mapoo_account_id', enteredUid);
          localStorage.setItem('mapoo_account_created', 'yes');
          localStorage.removeItem('mapoo_profile_completed');
        }
        await openMainApp();
        if (!isComplete) {
          switchTab('profile');
          showStatus('अपनी प्रोफाइल और GPS लोकेशन पूरी करके “सेव डिटेल्स” दबाएँ।');
        }
      } catch (error) { alert('लॉगिन नहीं हुआ: ' + (error.message || 'कृपया दोबारा प्रयास करें।')); }
      finally { setGateBusy(false, 'pinLoginBtn'); }
    }

    async function createAccountWithPin() {
      if (!requireSupabase()) return;
      const phone = normalizePhone(document.getElementById('loginPhone').value.trim());
      const pin = document.getElementById('loginPin').value.trim();
      if (!phone) { alert('कृपया सही 10 अंकों का मोबाइल नंबर दर्ज करें।'); return; }
      if (!/^\d{4}$/.test(pin)) { alert('कृपया 4 अंकों का PIN दर्ज करें।'); return; }
      setGateBusy(true, 'createPinBtn', 'अकाउंट बनाया जा रहा है...');
      try {
        const { data, error } = await supabaseClient.rpc('mapoo_register_with_pin', { p_phone: phone, p_pin: pin });
        if (error) throw error;
        const account = Array.isArray(data) ? data[0] : data;
        if (!account || !account.account_id) throw new Error('अकाउंट ID नहीं मिली।');
        enteredPhone = phone; enteredUid = account.account_id;
        localStorage.setItem('mapoo_saved_phone', enteredPhone);
        localStorage.setItem('mapoo_account_id', enteredUid);
        localStorage.setItem('mapoo_account_created', 'yes');
        localStorage.removeItem('mapoo_profile_completed');
        document.getElementById('loginPin').value = '';
        updateLoginGate();
        await openMainApp();
      } catch (error) {
        try {
          const { data: loginData, error: loginError } = await supabaseClient.rpc(
            'mapoo_login_with_pin', { p_phone: phone, p_pin: pin }
          );
          if (loginError) throw loginError;
          const existing = Array.isArray(loginData) ? loginData[0] : loginData;
          if (!existing || !existing.account_id) throw new Error('इस नंबर का PIN अलग है। पहली बार बनाया गया वही PIN डालें।');
          enteredPhone = phone;
          enteredUid = existing.account_id;
          const { data: profileData, error: profileError } = await supabaseClient.rpc(
            'mapoo_get_own_profile', { p_account_id: enteredUid }
          );
          if (profileError) throw profileError;
          const row = Array.isArray(profileData) ? profileData[0] : profileData;
          const complete = !!(row && row.full_name && row.father_name && row.address &&
            row.latitude != null && row.longitude != null);
          document.getElementById('loginPin').value = '';
          if (complete) {
            localStorage.setItem('mapoo_saved_phone', enteredPhone);
            localStorage.setItem('mapoo_account_id', enteredUid);
            localStorage.setItem('mapoo_account_created', 'yes');
            localStorage.setItem('mapoo_profile_completed', 'yes');
          } else {
            localStorage.setItem('mapoo_saved_phone', enteredPhone);
            localStorage.setItem('mapoo_account_id', enteredUid);
            localStorage.setItem('mapoo_account_created', 'yes');
            localStorage.removeItem('mapoo_profile_completed');
          }
          await openMainApp();
          if (!complete) {
            switchTab('profile');
            showStatus('अपनी प्रोफाइल और GPS लोकेशन पूरी करके “सेव डिटेल्स” दबाएँ।');
          }
        } catch (resumeError) {
          alert('रजिस्ट्रेशन आगे नहीं बढ़ा: ' + (resumeError.message || error.message || 'कृपया नंबर और PIN जाँचें।'));
        }
      }
      finally { setGateBusy(false, 'createPinBtn'); }
    }
    async function openMainApp() {
      document.getElementById('firstTimeGate').style.display = 'none';
      document.getElementById('mainAppContainer').style.display = 'block';
      document.getElementById('phoneNumber').value = enteredPhone.replace(/^\+91/, '');
      await loadOwnProfile();
      initializeBannerAds();
    }

    window.addEventListener('DOMContentLoaded', async () => {
      const mainApp = document.getElementById('mainAppContainer');
      const consentScreen = document.getElementById('consentScreen');
      const loginGate = document.getElementById('firstTimeGate');
      const loader = document.getElementById('startupLoader');
      if (mainApp) mainApp.style.display = 'none';
      const privacyAccepted = localStorage.getItem('mapooPrivacyConsentV1') === 'accepted';
      const completedProfile = localStorage.getItem('mapoo_profile_completed') === 'yes';
      if (!completedProfile) {
        // An account that never completed profile/GPS must not become PIN-only.
        localStorage.removeItem('mapoo_saved_phone');
        localStorage.removeItem('mapoo_account_id');
        localStorage.removeItem('mapoo_account_created');
      }
      consentScreen.style.display = privacyAccepted ? 'none' : 'flex';
      loginGate.style.display = privacyAccepted ? 'flex' : 'none';
      updateLoginGate();
      if (loader) loader.style.display = 'none';
      const phone = document.getElementById('loginPhone');
      const pin = document.getElementById('loginPin');
      phone.addEventListener('input', () => phone.value = phone.value.replace(/\D/g, '').slice(0, 10));
      pin.addEventListener('input', () => pin.value = pin.value.replace(/\D/g, '').slice(0, 4));
    });

    window.acceptPrivacyConsent = function acceptPrivacyConsent() {
      localStorage.setItem('mapooPrivacyConsentV1', 'accepted');
      document.getElementById('consentScreen').style.display = 'none';
      document.getElementById('firstTimeGate').style.display = 'flex';
      document.getElementById('mainAppContainer').style.display = 'none';
      updateLoginGate();
    };

    function toggleSettingsMenu() {
      document.getElementById('settingsMenu').classList.toggle('open');
    }

    async function loadOwnProfile() {
      if (!supabaseClient || !enteredPhone || !enteredUid) return;
      try {
        const { data, error } = await supabaseClient.rpc('mapoo_get_own_profile', { p_account_id: enteredUid });
        if (error) throw error;
        const row = Array.isArray(data) ? data[0] : data;
        if (row) {
          const visibilityWasManuallyChanged = localStorage.getItem('mapoo_visibility_user_changed') === 'yes';
          // A new install/profile defaults to searchable. Searching never changes this setting;
          // only a successful manual switch action records the user's choice.
          if (!visibilityWasManuallyChanged && row.is_visible === false && row.full_name && row.latitude != null && row.longitude != null) {
            const { error: visibilityError } = await supabaseClient.rpc('mapoo_set_visibility', {
              p_account_id: enteredUid, p_is_visible: true
            });
            if (visibilityError) console.warn('Could not apply default searchable setting:', visibilityError);
          }
          fillProfileData({ phone: row.phone_number || enteredPhone, name: row.full_name, father: row.father_name,
            address: row.address, mohalla: row.mohalla, lat: row.latitude, lng: row.longitude,
            accuracy: row.location_accuracy_m, visible: visibilityWasManuallyChanged ? row.is_visible : true });
          const complete = !!(row.full_name && row.father_name && row.address &&
            row.latitude != null && row.longitude != null);
